<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theming (see ui/theme). This platform theme only
         sets the pre-Compose window chrome. Parent is a plain platform theme so
         we don't need the Material Components XML library as a dependency. -->
    <style name="Theme.Phasionary" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
