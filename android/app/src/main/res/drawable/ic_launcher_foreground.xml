<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal mark: a monospace-style checkmark inside brackets, drawn as a
     vector so no raster launcher assets are needed (minSdk 26 = adaptive only). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- left bracket -->
    <path
        android:strokeColor="#98C379"
        android:strokeWidth="4"
        android:strokeLineCap="square"
        android:fillColor="#00000000"
        android:pathData="M42,38 L34,38 L34,70 L42,70" />
    <!-- right bracket -->
    <path
        android:strokeColor="#98C379"
        android:strokeWidth="4"
        android:strokeLineCap="square"
        android:fillColor="#00000000"
        android:pathData="M66,38 L74,38 L74,70 L66,70" />
    <!-- check -->
    <path
        android:strokeColor="#98C379"
        android:strokeWidth="5"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter"
        android:fillColor="#00000000"
        android:pathData="M46,55 L52,62 L64,48" />
</vector>
