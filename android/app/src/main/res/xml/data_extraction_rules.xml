<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup/transfer rules. allowBackup="false" already
  disables cloud backup, but device-to-device transfer is governed separately
  and would otherwise still copy app data to a new phone.

  Everything is excluded because the app's only persisted state is the server
  URL and the bearer token, and that token grants full read/write access to
  every project. Re-entering it on a new device is a few seconds' work; having
  it silently follow the user onto another device is not a trade worth making.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
